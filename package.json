{
  "name": "edusol",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "eleventy --serve",
    "build": "eleventy",
    "icons": "node scripts/generate-icons.mjs",
    "check:html": "html-validate \"_site/**/*.html\"",
    "check:links": "node scripts/check-links.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "test": "npm run check:api && npm run build && npm run check:html && npm run check:links && npm run check:headers && npm run check:a11y && npm run check:form && npm run check:ui && npm run check:form:vercel",
    "check:form": "node scripts/check-form.mjs",
    "serve": "node scripts/serve.mjs",
    "check:headers": "node scripts/check-headers.mjs",
    "check:ui": "node scripts/check-ui.mjs",
    "check:api": "node --test \"tests/**/*.test.js\"",
    "check:form:vercel": "CONTACT_BACKEND=vercel eleventy --quiet && node scripts/check-form.mjs && npm run build --silent"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@axe-core/playwright": "^4.13.0",
    "@fontsource/poppins": "^5.3.0",
    "html-validate": "^11.16.0",
    "lightningcss": "^1.33.0",
    "playwright": "^1.63.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.4"
  },
  "dependencies": {
    "nodemailer": "^10.0.10"
  }
}

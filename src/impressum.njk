      </p>

      </div>
    </section>
    <section class="legal-sec" aria-labelledby="urheberrecht" data-legal-sec>
      <h2 id="urheberrecht">Urheberrechte</h2>
      <div class="legal-sec__body" id="urheberrecht-text">

# Vorlage für die Umgebungsvariablen in Vercel (Settings → Environment Variables).
# Diese Datei enthält KEINE echten Werte – echte Zugangsdaten nie ins Repo committen.

# Kontaktformular über die eigene Funktion /api/contact statt Formspree
CONTACT_BACKEND=vercel

# SMTP-Zugang des Postfachs (Hostpoint; eigenes Postfach nur für den Versand)
SMTP_HOST=asmtp.mail.hostpoint.ch
SMTP_PORT=587
SMTP_USER=form@edusol.ch
SMTP_PASS=

# Empfänger der Anfragen und Absenderadresse (muss zum SMTP-Konto passen)
MAIL_TO=info@edusol.ch
MAIL_FROM="EDUSOL Website <form@edusol.ch>"

# Optional: Speed Insights (kostenpflichtig, erst nach Aktivierung in Vercel)
# SPEED_INSIGHTS=true
